<script type="module">
  import { renderNewRequestForm } from "new-request-form";

  const container = document.getElementById("new-request-form");

  const settings = {{json settings}};

  const props = {
    requestForm: {{json new_request_form}},
    newRequestPath: {{json (page_path 'new_request')}},
    parentId: {{json parent.id}},
    parentIdPath: {{json parent.url}},
    locale: {{json help_center.locale}},
    baseLocale: {{json help_center.base_locale}},
    hasAtMentions: {{json help_center.at_mentions_enabled}},
    userRole: {{json user.role}},
    userId: {{json user.id}},
    brandId: {{json brand.id}},
    organizations: {{json user.organizations}},
    wysiwyg: true,
    answerBotModal: {
      answerBot: {{json answer_bot}},
      hasRequestManagement: {{json help_center.request_management_enabled}},
      isSignedIn: {{json signed_in}},
      helpCenterPath: {{json (page_path 'help_center')}},
      requestsPath: {{json (page_path 'requests')}},
      requestPath: {{json (page_path 'request' id=answer_bot.request_id)}}
    },
  };
  renderNewRequestForm(settings, props, container);
</script>
<script>

  const form =  document.getElementById("new-request-form");
  form.classList.add("hide");


  /*Toggle function to show and hide back btn, form and field boxes*/
  const ticket_field_boxes = document.getElementById("multiple-ticket-forms");
  <!--     const ticketFormBox = document.getElementById("new_request"); -->
  const button = document.getElementById("back_btn");
  <!--     const requests_list = document.getElementsByClassName("requests_list")[0]; -->
  if (window.location.href !== "https://sabroefactory.zendesk.com/hc/en-us/requests/new") {
    /*Form and button is visible*/
    <!--         ticketFormBox.classList.remove("hide"); -->
    button.classList.remove("hide");
    ticket_field_boxes.classList.add("hide");
    form.classList.remove("hide");
    <!--         requests_list.classList.add("hide"); -->

  } else {
    /*Custom field boxes is visible, form and button is hidden*/
    <!--         ticketFormBox.classList.add("hide"); -->
    button.classList.add("hide");
    ticket_field_boxes.classList.remove("hide");
  }

  if (document.getElementsByClassName("sign-in").length !== 0) {
    // Hide "See all requests button"
    <!--         requests_list.classList.add("hide"); -->
  }

</script>
